DEFINE QLOCAL('BANKCORE.BACKOUT') +
       DESCR('Requests that repeatedly failed or cannot be answered') +
       DEFPSIST(YES) +
       REPLACE

DEFINE QLOCAL('BANKCORE.ACCTINQ.REQUEST') +
       DESCR('Account inquiry requests (COBOL ACCTINQ)') +
       DEFPSIST(YES) MAXMSGL(200) +
       BOTHRESH(3) BOQNAME('BANKCORE.BACKOUT') HARDENBO +
       REPLACE

DEFINE QLOCAL('BANKCORE.ACCTDEP.REQUEST') +
       DESCR('Deposit requests (COBOL ACCTDEP)') +
       DEFPSIST(YES) MAXMSGL(200) +
       BOTHRESH(3) BOQNAME('BANKCORE.BACKOUT') HARDENBO +
       REPLACE

DEFINE QLOCAL('BANKCORE.ACCTWDR.REQUEST') +
       DESCR('Withdrawal requests (COBOL ACCTWDR)') +
       DEFPSIST(YES) MAXMSGL(200) +
       BOTHRESH(3) BOQNAME('BANKCORE.BACKOUT') HARDENBO +
       REPLACE

DEFINE QLOCAL('BANKCORE.TRXINQ.REQUEST') +
       DESCR('Transaction inquiry requests (COBOL TRXINQ)') +
       DEFPSIST(YES) MAXMSGL(200) +
       BOTHRESH(3) BOQNAME('BANKCORE.BACKOUT') HARDENBO +
       REPLACE

DEFINE QLOCAL('BANKCORE.REPLY.BANKSVC') +
       DESCR('Replies from the core banking system to banking-svc') +
       DEFPSIST(YES) +
       REPLACE

SET AUTHREC PROFILE('BANKCORE.**') OBJTYPE(QUEUE) PRINCIPAL('app') AUTHADD(BROWSE,GET,INQ,PUT,PASSALL)
