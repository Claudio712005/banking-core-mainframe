//BKRUN    JOB (ACCTINFO),'BANKCORE RUN',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*********************************************************************
//* JOB       : BKRUN
//* PURPOSE   : EXECUTES THE BATCH DRIVER BKBATDRV ONCE FOR ONE
//*             REQUEST DATASET (AD HOC EXECUTION / TESTING).
//* TARGET    : Z/OS WITH DB2 DATA ACCESS MODULES (PHASE 2). THE
//*             PROGRAM RUNS UNDER THE TSO TERMINAL MONITOR PROGRAM
//*             (IKJEFT01) SO THAT THE DSN COMMAND ATTACHES IT TO DB2.
//*-------------------------------------------------------------------
//* PLACEHOLDERS - REPLACE BEFORE SUBMITTING:
//*   APPHLQ    APPLICATION HIGH LEVEL QUALIFIER
//*   DB2SSID   DB2 SUBSYSTEM ID
//*   DB2PLAN   DB2 PLAN BOUND FOR THE BANKCORE PACKAGES
//*   DB2LOAD   DB2 SDSNLOAD LIBRARY (SITE SPECIFIC NAME)
//*   REQDSN    REQUEST DATASET (RECFM=FB, LRECL=200)
//*-------------------------------------------------------------------
//* DD NAMES (MATCH THE ASSIGN CLAUSES):
//*   REQIN     REQUEST MESSAGES,  LAYOUT COPYBOOK REQUEST
//*   RSPOUT    RESPONSE MESSAGES, LAYOUT COPYBOOK RESPONSE
//*   ACCOUNT / CUSTOMER / TRANSACTION DATA: DB2 TABLES (NO DD).
//*-------------------------------------------------------------------
//* RERUN     : DELETE THE ADHOC.RESPONSES DATASET FIRST (DISP=NEW).
//* RETURN CODES OF STEP RUNDRV: 0 OK, 4 REJECTS, 12 TECHNICAL
//*   FAILURE (PROCESSING STOPPED), 16 FILE ERROR. SEE BKBATDRV.
//*********************************************************************
//         SET APPHLQ=YOURHLQ
//         SET DB2SSID=DB2X
//         SET DB2PLAN=BKCOREPL
//         SET DB2LOAD=DB2.CHANGEME.SDSNLOAD
//         SET REQDSN=YOURHLQ.BANKCORE.ADHOC.REQUESTS
//*
//RUNDRV   EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DISP=SHR,DSN=&APPHLQ..BANKCORE.LOADLIB
//         DD DISP=SHR,DSN=&DB2LOAD
//REQIN    DD DISP=SHR,DSN=&REQDSN
//RSPOUT   DD DSN=&APPHLQ..BANKCORE.ADHOC.RESPONSES,
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSALLDA,
//            SPACE=(TRK,(15,15),RLSE),
//            DCB=(RECFM=FB,LRECL=300,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *,SYMBOLS=JCLONLY
  DSN SYSTEM(&DB2SSID)
  RUN PROGRAM(BKBATDRV) PLAN(&DB2PLAN)
  END
/*
