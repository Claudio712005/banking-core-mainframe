//BKCBLCL  PROC MEMBER=
//*********************************************************************
//* PROCEDURE : BKCBLCL  (CATALOGED PROCEDURE - STORE IN PROCLIB)
//* PURPOSE   : COMPILE + LINK-EDIT ONE BATCH COBOL MODULE
//*             (IBM ENTERPRISE COBOL FOR Z/OS 6.X, NO DB2 PRECOMPILE)
//*-------------------------------------------------------------------
//* SYMBOLS (SET BY THE CALLING JOB WITH // SET):
//*   MEMBER  : SOURCE MEMBER = LOAD MODULE NAME          (EXEC PARM)
//*   APPHLQ  : APPLICATION HIGH LEVEL QUALIFIER          (PLACEHOLDER)
//*   IGYHLQ  : HLQ OF THE COBOL COMPILER (SIGYCOMP)      (SITE VALUE)
//*   LEHLQ   : HLQ OF LANGUAGE ENVIRONMENT (SCEELKED)    (SITE VALUE)
//*-------------------------------------------------------------------
//* COMPILER OPTIONS:
//*   RENT      REENTRANT CODE (MANDATORY FOR FUTURE CICS USE)
//*   DYNAM     CALLS RESOLVED AT RUN TIME (MODULES LINKED SEPARATELY,
//*             DAOS CAN BE SWAPPED WITHOUT RELINKING CALLERS)
//*   TRUNC(STD) BINARY FIELDS TRUNCATED TO PICTURE (PORTABLE RESULT)
//*   SSRANGE   SUBSCRIPT/REFERENCE MODIFICATION CHECKING.
//*             REVIEW WITH PERFORMANCE STANDARDS BEFORE PRODUCTION.
//*   MAP,XREF,LIST  LISTINGS FOR ANALYSIS
//*-------------------------------------------------------------------
//* THE LINK STEP RUNS ONLY WHEN THE COMPILE RC <= 4.
//*********************************************************************
//COMPILE  EXEC PGM=IGYCRCTL,REGION=0M,
//             PARM='RENT,DYNAM,TRUNC(STD),SSRANGE,MAP,XREF,LIST'
//STEPLIB  DD DISP=SHR,DSN=&IGYHLQ..SIGYCOMP
//SYSIN    DD DISP=SHR,DSN=&APPHLQ..BANKCORE.COBOL(&MEMBER)
//SYSLIB   DD DISP=SHR,DSN=&APPHLQ..BANKCORE.COPYLIB
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&OBJECT,DISP=(NEW,PASS),UNIT=SYSALLDA,
//            SPACE=(CYL,(1,1)),DCB=(RECFM=FB,LRECL=80)
//SYSMDECK DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT1   DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT2   DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT3   DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT4   DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT5   DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT6   DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT7   DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT8   DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT9   DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT10  DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT11  DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT12  DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT13  DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT14  DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//SYSUT15  DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//*
//LKED     EXEC PGM=IEWBLINK,COND=(4,LT,COMPILE),
//             PARM='LIST,MAP,XREF,RENT'
//SYSLIB   DD DISP=SHR,DSN=&LEHLQ..SCEELKED
//SYSLIN   DD DSN=&&OBJECT,DISP=(OLD,DELETE)
//SYSLMOD  DD DISP=SHR,DSN=&APPHLQ..BANKCORE.LOADLIB(&MEMBER)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
