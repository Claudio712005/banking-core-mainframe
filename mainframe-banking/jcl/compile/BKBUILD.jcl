//BKBUILD  JOB (ACCTINFO),'BANKCORE BUILD',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*********************************************************************
//* JOB       : BKBUILD
//* PURPOSE   : COMPILE AND LINK-EDIT ALL PORTABLE BANKCORE MODULES.
//*             EACH MODULE IS A SEPARATE LOAD MODULE (CALLED WITH
//*             DYNAM), SO ONE STEP FAILING DOES NOT STOP THE OTHERS;
//*             CHECK THE RC OF EVERY STEP.
//*-------------------------------------------------------------------
//* PLACEHOLDERS: SEE BKCOMPL.
//*-------------------------------------------------------------------
//* MODULE      ROLE
//*   BKVALID   INPUT VALIDATION
//*   BKRESP    RESPONSE BUILDER / TECHNICAL LOG
//*   ACCTPOST  POSTING ENGINE
//*   ACCTINQ   ENTRY: ACCOUNT INQUIRY
//*   ACCTDEP   ENTRY: DEPOSIT
//*   ACCTWDR   ENTRY: WITHDRAWAL
//*   TRXINQ    ENTRY: TRANSACTION INQUIRY
//*   BKBATDRV  BATCH DRIVER. ON Z/OS ITS TWO SELECT CLAUSES USE
//*             ORGANIZATION SEQUENTIAL (RECFM=FB) INSTEAD OF THE LAB
//*             LINE SEQUENTIAL - SEE DOCS/ZOS-MIGRATION.MD.
//*   ACCTDAO / CUSTDAO / TRXDAO: DB2 VERSIONS, PHASE 2 (DB2
//*             PRECOMPILE/COPROCESSOR + BIND ARE NOT IN THIS JOB).
//*   BKMQADP   CICS + MQ ADAPTER. NOT BUILT HERE: NEEDS THE CICS
//*             COPROCESSOR, SCSQCOBC/SDFHCOB IN SYSLIB AND THE
//*             CSQCSTUB STUB - SEE DOCS/MQ-INTEGRATION.MD.
//*********************************************************************
//         JCLLIB ORDER=YOURHLQ.BANKCORE.PROCLIB
//         SET APPHLQ=YOURHLQ
//         SET IGYHLQ=IGY.CHANGEME
//         SET LEHLQ=CEE
//*
//BKVALID  EXEC BKCBLCL,MEMBER=BKVALID
//BKRESP   EXEC BKCBLCL,MEMBER=BKRESP
//ACCTPOST EXEC BKCBLCL,MEMBER=ACCTPOST
//ACCTINQ  EXEC BKCBLCL,MEMBER=ACCTINQ
//ACCTDEP  EXEC BKCBLCL,MEMBER=ACCTDEP
//ACCTWDR  EXEC BKCBLCL,MEMBER=ACCTWDR
//TRXINQ   EXEC BKCBLCL,MEMBER=TRXINQ
//BKBATDRV EXEC BKCBLCL,MEMBER=BKBATDRV
